# =============================================================================
# Research Data Platform — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before deploying.

# Domain (used by docker-compose.prod.yml for CORS)
DOMAIN=yourdomain.com

# Database
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Redis
REDIS_PASSWORD=change_me_to_a_strong_redis_password

# JWT Secret (generate with: openssl rand -hex 64)
SECRET_KEY=change_me_generate_with_openssl_rand_hex_64

# CORS origins (JSON array of allowed frontend URLs)
CORS_ORIGINS=["https://yourdomain.com"]

# Cloudflare R2 object storage (leave blank to use local disk in dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
